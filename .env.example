# ---------------------------------------------------------------------------
# Copy to `.env.local` and fill in real values. Never commit `.env.local`.
# `supabase start` prints all three values for local development.
# ---------------------------------------------------------------------------

# Supabase project URL. Local development default: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=

# Anon/publishable key. Reaches the browser, so it is restricted by row-level
# security to reading the public dashboard tables only.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role/secret key. Server-side only: it bypasses row-level security and
# is the only credential allowed to write runtime knowledge or seed bootstrap
# identities. It must never be exposed to the browser or prefixed NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

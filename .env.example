# ---------------------------------------------------------------------------
# Copy to `.env.local` and fill in real values. Never commit `.env.local`.
# `supabase start` prints all three values for local development.
# ---------------------------------------------------------------------------

# Supabase project URL. Local development default: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=

# Anon/publishable key. Reaches the browser, so it is restricted by row-level
# security to reading the public dashboard tables only.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role/secret key. Server-side only: it bypasses row-level security and
# is the only credential allowed to write runtime knowledge or seed bootstrap
# identities. It must never be exposed to the browser or prefixed NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# AI provider. Required for the chat agent; the rest of the app runs without it.
# ---------------------------------------------------------------------------

# Anthropic API key, from https://console.anthropic.com. Server-side only.
ANTHROPIC_API_KEY=

# The model the agent runs on. Configuration rather than a literal in code, so
# swapping models never means editing application logic, and every agent run
# records which model actually produced the answer.
# Example: claude-sonnet-5
ANTHROPIC_MODEL=

# ---------------------------------------------------------------------------
# Optional. Company research works without this - no paid data provider is
# required for this milestone.
# ---------------------------------------------------------------------------

# Enables resolving a company's search leads (src/db/repositories - table
# company_search_leads) into real source candidates. Left unset, source
# planning still runs on the verified primary domain and existing evidence;
# it reports the gap as an explicit warning rather than silently narrowing
# coverage. No vendor is wired up yet - see
# src/research/sources/search-provider.ts.
SEARCH_PROVIDER_API_KEY=

# Required only for direct POST /api/monitor/run calls. Keep this server-only;
# use the x-ma-operator-secret header from an internal scheduler or operator.
MA_OPERATOR_SECRET=
